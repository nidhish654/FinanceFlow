// ============================================================================
// FinanceFlow Database Schema
// Version: 1.0
// Database: PostgreSQL (Neon)
// ORM: Prisma
// Author: Nidhish Shettigar
//
// NOTE:
// This application is designed to support:
// - Multiple Finance Profiles (India, Japan, Business, etc.)
// - Multi-currency
// - Budgeting
// - Expense Tracking
// - Salary Planning
// - Future AI Insights
// ============================================================================

generator client {
  provider = "prisma-client-js"
}


datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  CASH
  BANK
  CREDIT_CARD
  DIGITAL_WALLET
  SAVINGS
  INVESTMENT
}

enum AccountStatus {
  ACTIVE
  ARCHIVED
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum Priority {
  NEED
  WANT
  SAVINGS
}

enum BudgetPeriod {
  WEEKLY
  MONTHLY
  YEARLY
  CUSTOM
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum Currency {
  INR
  JPY
  USD
  EUR
  GBP
}

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

enum WeekStart {
  SUNDAY
  MONDAY
}

enum SalaryFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  YEARLY
}

enum BudgetStatus {
  ACTIVE
  ARCHIVED
}

enum FinanceProfileStatus {
  ACTIVE
  ARCHIVED
}

model User {
  id String @id @default(uuid()) @db.Uuid

  name String

  email String @unique

  emailVerified Boolean @default(false)

  image String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  // Better Auth
  sessions     Session[]
  authAccounts Account[]

  // FinanceFlow
  /// Finance Profiles owned by this user
  financeProfiles FinanceProfile[] @relation("UserFinanceProfiles")

  /// Currently selected Finance Profile
  activeFinanceProfileId String? @db.Uuid

  activeFinanceProfile FinanceProfile? @relation("ActiveFinanceProfile", fields: [activeFinanceProfileId], references: [id], onDelete: SetNull)

  @@index([activeFinanceProfileId])
  @@map("users")
}

model FinanceProfile {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid

  name        String
  description String?

  baseCurrency Currency

  status FinanceProfileStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation("UserFinanceProfiles", fields: [userId], references: [id], onDelete: Cascade)

  /// Users currently using this profile
  activeUsers User[] @relation("ActiveFinanceProfile")

  settings Settings?

  accounts FinanceAccount[]

  categories Category[]

  transactions Transaction[]

  budgets Budget[]

  salaryPlans SalaryPlan[]

  @@unique([userId, name])
  @@index([userId])
  @@map("finance_profiles")
}

model Settings {
  id String @id @default(uuid()) @db.Uuid

  financeProfileId String @unique @db.Uuid

  theme Theme @default(SYSTEM)

  weekStart WeekStart @default(MONDAY)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  financeProfile FinanceProfile @relation(fields: [financeProfileId], references: [id], onDelete: Cascade)

  @@map("settings")
}

model FinanceAccount {
  id String @id @default(uuid()) @db.Uuid

  financeProfileId String @db.Uuid

  name String

  description String?

  type AccountType

  currency Currency?

  openingBalance Decimal @db.Decimal(12, 2)

  status AccountStatus @default(ACTIVE)

  color String?

  icon String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  // Relations

  financeProfile FinanceProfile @relation(fields: [financeProfileId], references: [id], onDelete: Cascade)

  outgoingTransactions Transaction[] @relation("AccountTransactions")

  incomingTransfers Transaction[] @relation("TransferTransactions")

  @@unique([financeProfileId, name])
  @@index([financeProfileId])
  @@map("accounts")
}

model Account {
  id String @id @default(cuid())

  accountId String

  providerId String

  userId String @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  accessToken String?

  refreshToken String?

  idToken String?

  accessTokenExpiresAt DateTime?

  refreshTokenExpiresAt DateTime?

  scope String?

  password String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("account")
}

model Category {
  id String @id @default(uuid()) @db.Uuid

  financeProfileId String @db.Uuid

  parentCategoryId String? @db.Uuid

  name String

  description String?

  icon String?

  color String?

  type CategoryType

  displayOrder Int @default(0)

  isDefault Boolean @default(false)

  isArchived Boolean @default(false)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  // Relations

  financeProfile FinanceProfile @relation(fields: [financeProfileId], references: [id], onDelete: Cascade)

  parent Category? @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id])

  children Category[] @relation("CategoryHierarchy")

  transactions Transaction[]

  budgets Budget[]

  @@unique([financeProfileId, type, name])
  @@index([financeProfileId])
  @@index([parentCategoryId])
  @@map("categories")
}

model Budget {
  id String @id @default(uuid()) @db.Uuid

  financeProfileId String @db.Uuid

  categoryId String? @db.Uuid

  amount Decimal @db.Decimal(12, 2)

  period BudgetPeriod

  startDate DateTime

  endDate DateTime

  status BudgetStatus @default(ACTIVE)

  notes String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  // Relations

  financeProfile FinanceProfile @relation(fields: [financeProfileId], references: [id], onDelete: Cascade)

  category Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([financeProfileId, categoryId, startDate, endDate])
  @@index([financeProfileId])
  @@index([categoryId])
  @@index([financeProfileId, categoryId])
  @@map("budgets")
}

model Transaction {
  id String @id @default(uuid()) @db.Uuid

  financeProfileId String @db.Uuid

  accountId String @db.Uuid

  transferAccountId String? @db.Uuid

  categoryId String? @db.Uuid

  type TransactionType

  priority Priority?

  amount Decimal @db.Decimal(12, 2)

  description String?

  merchant String?

  notes String?

  referenceNumber String?

  transactionDate DateTime

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  // Relations

  financeProfile FinanceProfile @relation(fields: [financeProfileId], references: [id], onDelete: Cascade)

  account FinanceAccount @relation("AccountTransactions", fields: [accountId], references: [id])

  transferAccount FinanceAccount? @relation("TransferTransactions", fields: [transferAccountId], references: [id])

  category Category? @relation(fields: [categoryId], references: [id])

  @@index([financeProfileId])
  @@index([accountId])
  @@index([categoryId])
  @@index([transactionDate])
  @@index([financeProfileId, transactionDate])
  @@map("transactions")
}

model SalaryPlan {
  id String @id @default(uuid()) @db.Uuid

  financeProfileId String @db.Uuid

  title String

  frequency SalaryFrequency

  grossSalary Decimal @db.Decimal(12, 2)

  expectedTax Decimal @db.Decimal(12, 2)

  expectedInsurance Decimal @db.Decimal(12, 2)

  expectedHousing Decimal @db.Decimal(12, 2)

  expectedUtilities Decimal @db.Decimal(12, 2)

  expectedFood Decimal @db.Decimal(12, 2)

  expectedTransportation Decimal @db.Decimal(12, 2)

  expectedSavings Decimal @db.Decimal(12, 2)

  effectiveFrom DateTime

  effectiveTo DateTime?

  notes String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  financeProfile FinanceProfile @relation(fields: [financeProfileId], references: [id], onDelete: Cascade)

  @@index([financeProfileId])
  @@map("salary_plans")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  userId String @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
