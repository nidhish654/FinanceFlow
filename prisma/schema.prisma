generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String           @id @default(uuid()) @db.Uuid
  name                   String
  email                  String           @unique
  emailVerified          Boolean          @default(false)
  image                  String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  /// Currently selected Finance Profile
  activeFinanceProfileId String?          @db.Uuid
  authAccounts           Account[]
  financeProfiles        FinanceProfile[] @relation("UserFinanceProfiles")
  sessions               Session[]
  activeFinanceProfile   FinanceProfile?  @relation("ActiveFinanceProfile", fields: [activeFinanceProfileId], references: [id])

  @@index([activeFinanceProfileId])
  @@map("users")
}

model FinanceProfile {
  id           String               @id @default(uuid()) @db.Uuid
  userId       String               @db.Uuid
  name         String
  description  String?
  baseCurrency Currency
  status       FinanceProfileStatus @default(ACTIVE)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  accounts     FinanceAccount[]
  budgets      Budget[]
  categories   Category[]
  user         User                 @relation("UserFinanceProfiles", fields: [userId], references: [id], onDelete: Cascade)
  salaryPlans  SalaryPlan[]
  settings     Settings?
  goals        Goal[]
  transactions Transaction[]
  activeUsers  User[]               @relation("ActiveFinanceProfile")

  @@unique([userId, name])
  @@index([userId])
  @@map("finance_profiles")
}

model Settings {
  id               String @id @default(uuid()) @db.Uuid
  financeProfileId String @unique @db.Uuid

  // Existing
  theme     Theme     @default(SYSTEM)
  weekStart WeekStart @default(MONDAY)

  // New General/Preferences
  language     Language     @default(ENGLISH)
  timezone     String       @default("UTC")
  dateFormat   DateFormat   @default(DD_MM_YYYY)
  timeFormat   TimeFormat   @default(H24)
  numberFormat NumberFormat @default(INDIAN)

  // New Financial Defaults
  defaultAccountId         String?          @db.Uuid
  defaultExpenseCategoryId String?          @db.Uuid
  defaultIncomeCategoryId  String?          @db.Uuid
  defaultTransactionType   TransactionType?

  monthStart           Int                  @default(1)
  fiscalYear           Month                @default(JANUARY)
  showDecimals         Boolean              @default(true)
  negativeNumberFormat NegativeNumberFormat @default(MINUS)

  // New Appearance
  accentColor       AccentColor @default(DEFAULT)
  compactMode       Boolean @default(false)
  reduceMotion      Boolean @default(false)
  animationsEnabled Boolean @default(true)

  // Avatar Preferences
  avatarStyle String @default("adventurerNeutral")
  avatarSeed  String @default("alex")

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  financeProfile FinanceProfile @relation(fields: [financeProfileId], references: [id], onDelete: Cascade)

  @@map("settings")
}

model FinanceAccount {
  id                   String         @id @default(uuid()) @db.Uuid
  financeProfileId     String         @db.Uuid
  name                 String
  description          String?
  type                 AccountType
  currency             Currency?
  openingBalance       Decimal        @db.Decimal(12, 2)
  status               AccountStatus  @default(ACTIVE)
  color                String?
  icon                 String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  financeProfile       FinanceProfile @relation(fields: [financeProfileId], references: [id], onDelete: Cascade)
  outgoingTransactions Transaction[]  @relation("AccountTransactions")
  incomingTransfers    Transaction[]  @relation("TransferTransactions")

  @@unique([financeProfileId, name])
  @@index([financeProfileId])
  @@map("accounts")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Category {
  id               String         @id @default(uuid()) @db.Uuid
  financeProfileId String         @db.Uuid
  parentCategoryId String?        @db.Uuid
  name             String
  description      String?
  icon             String?
  color            String?
  type             CategoryType
  displayOrder     Int            @default(0)
  isDefault        Boolean        @default(false)
  isArchived       Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  budgets          Budget[]
  financeProfile   FinanceProfile @relation(fields: [financeProfileId], references: [id], onDelete: Cascade)
  parent           Category?      @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id])
  children         Category[]     @relation("CategoryHierarchy")
  transactions     Transaction[]

  @@unique([financeProfileId, type, name])
  @@index([financeProfileId])
  @@index([parentCategoryId])
  @@map("categories")
}

model Budget {
  id               String         @id @default(uuid()) @db.Uuid
  financeProfileId String         @db.Uuid
  categoryId       String?        @db.Uuid
  amount           Decimal        @db.Decimal(12, 2)
  period           BudgetPeriod
  startDate        DateTime
  endDate          DateTime
  status           BudgetStatus   @default(ACTIVE)
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  category         Category?      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  financeProfile   FinanceProfile @relation(fields: [financeProfileId], references: [id], onDelete: Cascade)

  @@unique([financeProfileId, categoryId, startDate, endDate])
  @@index([financeProfileId])
  @@index([categoryId])
  @@index([financeProfileId, categoryId])
  @@map("budgets")
}

model Transaction {
  id                String          @id @default(uuid()) @db.Uuid
  financeProfileId  String          @db.Uuid
  accountId         String          @db.Uuid
  transferAccountId String?         @db.Uuid
  categoryId        String?         @db.Uuid
  type              TransactionType
  priority          Priority?
  amount            Decimal         @db.Decimal(12, 2)
  description       String?
  merchant          String?
  notes             String?
  referenceNumber   String?
  transactionDate   DateTime
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  account           FinanceAccount  @relation("AccountTransactions", fields: [accountId], references: [id])
  category          Category?       @relation(fields: [categoryId], references: [id])
  financeProfile    FinanceProfile  @relation(fields: [financeProfileId], references: [id], onDelete: Cascade)
  transferAccount   FinanceAccount? @relation("TransferTransactions", fields: [transferAccountId], references: [id])

  @@index([financeProfileId])
  @@index([accountId])
  @@index([categoryId])
  @@index([transactionDate])
  @@index([financeProfileId, transactionDate])
  @@map("transactions")
}

model SalaryPlan {
  id                     String          @id @default(uuid()) @db.Uuid
  financeProfileId       String          @db.Uuid
  title                  String
  frequency              SalaryFrequency
  grossSalary            Decimal         @db.Decimal(12, 2)
  expectedTax            Decimal         @db.Decimal(12, 2)
  expectedInsurance      Decimal         @db.Decimal(12, 2)
  expectedHousing        Decimal         @db.Decimal(12, 2)
  expectedUtilities      Decimal         @db.Decimal(12, 2)
  expectedFood           Decimal         @db.Decimal(12, 2)
  expectedTransportation Decimal         @db.Decimal(12, 2)
  expectedSavings        Decimal         @db.Decimal(12, 2)
  effectiveFrom          DateTime
  effectiveTo            DateTime?
  notes                  String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  financeProfile         FinanceProfile  @relation(fields: [financeProfileId], references: [id], onDelete: Cascade)

  @@index([financeProfileId])
  @@map("salary_plans")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Goal {
  id String @id @default(uuid()) @db.Uuid

  financeProfileId String @db.Uuid

  name String
  icon String?

  targetAmount Decimal @db.Decimal(14, 2)
  savedAmount  Decimal @default(0.00) @db.Decimal(14, 2)

  targetDate DateTime?
  notes      String?

  displayOrder Int @default(0)

  archived    Boolean   @default(false)
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  financeProfile FinanceProfile @relation(fields: [financeProfileId], references: [id], onDelete: Cascade)

  history GoalHistory[]

  @@index([financeProfileId])
  @@index([displayOrder])
  @@map("goals")
}

model GoalHistory {
  id String @id @default(uuid()) @db.Uuid

  goalId String @db.Uuid

  amount Decimal @db.Decimal(14, 2)

  type GoalHistoryType

  note String?

  createdAt DateTime @default(now())

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@map("goal_history")
}

enum AccountType {
  CASH
  BANK
  CREDIT_CARD
  DIGITAL_WALLET
  SAVINGS
  INVESTMENT
}

enum AccountStatus {
  ACTIVE
  ARCHIVED
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum Priority {
  NEED
  WANT
  SAVINGS
}

enum BudgetPeriod {
  WEEKLY
  MONTHLY
  YEARLY
  CUSTOM
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum Currency {
  INR
  JPY
  USD
  EUR
  GBP
}

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

enum AccentColor {
  DEFAULT
  PURPLE
  BLUE
  EMERALD
  ORANGE
  RED
  SLATE
}

enum WeekStart {
  SUNDAY
  MONDAY
}

enum Language {
  ENGLISH
}

enum DateFormat {
  DD_MM_YYYY
  MM_DD_YYYY
  YYYY_MM_DD
}

enum TimeFormat {
  H12 // 12-hour
  H24 // 24-hour
}

enum NumberFormat {
  INDIAN // 1,00,000.00
  WESTERN // 100,000.00
  EUROPEAN // 100.000,00
}

enum NegativeNumberFormat {
  MINUS // -100
  PARENTHESES // (100)
}

enum Month {
  JANUARY
  FEBRUARY
  MARCH
  APRIL
  MAY
  JUNE
  JULY
  AUGUST
  SEPTEMBER
  OCTOBER
  NOVEMBER
  DECEMBER
}

enum SalaryFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  YEARLY
}

enum BudgetStatus {
  ACTIVE
  ARCHIVED
}

enum FinanceProfileStatus {
  ACTIVE
  ARCHIVED
}

enum GoalHistoryType {
  DEPOSIT
  WITHDRAWAL
}
